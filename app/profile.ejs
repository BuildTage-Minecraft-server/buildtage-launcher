<div id="profileContainer" style="display: none;">
    <div id="profileInner">
        <div id="profileHeader">
            <div id="profileHeaderText">
                <span id="profileTitle"><%- lang('profile.title') %></span>
                <span id="profileSubtitle"><%- lang('profile.subtitle') %></span>
            </div>
            <div id="profileHeaderActions">
                <button id="profileLogout" type="button" class="profileButton danger"><%- lang('profile.logout') %></button>
                <button id="profileDone" type="button" class="profileButton primary"><%- lang('profile.done') %></button>
            </div>
        </div>
        <div id="profileBody">
            <div id="profileSkinColumn">
                <div id="profileSkinViewer">
                    <div id="profileSkinEmpty"><%- lang('profile.skinEmpty') %></div>
                </div>
                <div id="profileSkinHint"><%- lang('profile.skinHint') %></div>
                <div id="profileSkinActions">
                    <button id="profileSkinUpload" type="button" class="profileButton"><%- lang('profile.skinUpload') %></button>
                    <button id="profileSkinReset" type="button" class="profileButton danger"><%- lang('profile.skinReset') %></button>
                </div>
                <div id="profileSkinStatus" role="status"></div>
            </div>
            <div id="profileMain">
                <div id="profileIdentity">
                    <div id="profileHead"></div>
                    <div id="profileIdentityText">
                        <span id="profileNickLabel"><%- lang('profile.nickLabel') %></span>
                        <span id="profileNick">-</span>
                    </div>
                </div>
                <form id="profileAccountForm" autocomplete="off" novalidate>
                    <div class="profileSectionHead">
                        <span class="profileSectionTitle"><%- lang('profile.accountTitle') %></span>
                        <button id="profilePasswordToggle" type="button" class="profileLink" data-show="<%- lang('profile.showPasswords') %>" data-hide="<%- lang('profile.hidePasswords') %>"><%- lang('profile.showPasswords') %></button>
                    </div>
                    <div class="profileSectionDesc"><%- lang('profile.accountDesc') %></div>
                    <div id="profileFields">
                        <label class="profileField">
                            <span class="profileFieldLabel"><%- lang('profile.nameLabel') %></span>
                            <input type="text" id="profileName" class="profileInput" autocomplete="off" spellcheck="false" maxlength="16" placeholder="<%- lang('profile.namePlaceholder') %>">
                        </label>
                        <label class="profileField">
                            <span class="profileFieldLabel"><%- lang('profile.newPasswordLabel') %></span>
                            <input type="password" id="profileNewPassword" class="profileInput" autocomplete="new-password" placeholder="<%- lang('profile.newPasswordPlaceholder') %>">
                        </label>
                        <div class="profileField profileFieldSpacer"></div>
                        <label class="profileField">
                            <span class="profileFieldLabel"><%- lang('profile.repeatPasswordLabel') %></span>
                            <input type="password" id="profileRepeatPassword" class="profileInput" autocomplete="new-password" placeholder="<%- lang('profile.repeatPasswordPlaceholder') %>">
                        </label>
                        <label class="profileField">
                            <span class="profileFieldLabel"><%- lang('profile.currentPasswordLabel') %></span>
                            <input type="password" id="profileCurrentPassword" class="profileInput" autocomplete="current-password" placeholder="<%- lang('profile.currentPasswordPlaceholder') %>">
                        </label>
                        <div class="profileField profileFieldAction">
                            <button id="profileSave" type="submit" class="profileButton primary" disabled><%- lang('profile.save') %></button>
                        </div>
                    </div>
                    <div id="profileAccountStatus" role="status"></div>
                </form>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/profile.js"></script>
</div>
