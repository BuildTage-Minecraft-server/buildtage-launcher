<div id="loginOptionsContainer" style="display: none">
  <div id="loginOptionBackContainer" style="display: none;">
    <button id="loginOptionBackButton">
      <div id="loginOptionBackIcon">X</div>
      <span id="loginOptionBackText"><%- lang('login.loginCancelText') %></span>
    </button>
  </div>
  <div id="loginOptionsContent">
    <div class="loginOptionsMainContent">
      <img src="assets/images/buildtage-logo.svg" />
      <h2><%- lang('loginOptions.loginOptionsTitle') %></h2>
      <div class="loginOptionActions">
        <div class="loginOptionButtonContainer">
          <button id="loginOptionVISoftware" class="loginOptionButton">
