            </svg>
            <span><%- lang('loginOptions.continueAsGuest') %></span>
          </button>
        </div>
      </div>
      <div id="loginOptionCancelContainer" style="display: none">
        <button id="loginOptionCancelButton">
          <%- lang('loginOptions.cancelButton') %>
        </button>
      </div>
    </div>
  </div>
  <script src="./assets/js/scripts/loginOptions.js"></script>
  
</div>