        </div>
        <div class="loginOptionDivider" id="guestModeDivider">
          <span><%- lang('loginOptions.orContinueAs') %></span>
        </div>
        <div class="loginOptionButtonContainer" id="guestModeButtonContainer">
          <button id="loginOptionGuest" class="loginOptionButton loginOptionGuestButton">
            <svg class="w-6 h-6 text-gray-800 dark:text-white" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
